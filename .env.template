# Web App Security
# Use a long random string in production (e.g. python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET=change-me-to-a-long-random-string

# Admin dashboard login (flyer_app.py)
# App shell: / = public home, /signup = create demo account, /login = sign in,
# /app = workspace, /app/account = settings
ADMIN_USERNAME=admin
# Plain password is hashed in memory at startup. Prefer ADMIN_PASSWORD_HASH in production.
ADMIN_PASSWORD=change-me-strong-password
# Optional: store a hash instead of plaintext. Generate with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
# ADMIN_PASSWORD_HASH=scrypt:....
# Optional local override after Account → Change password: data/admin_auth.json (gitignored, dev-only)
#
# Login session & safety (optional — defaults work fine for demos):
# SESSION_HOURS = how long you stay logged in after Login (then you must Login again).
#   Does NOT turn the whole website off — only your private /app session expires.
# LOGIN_MAX_ATTEMPTS = wrong password tries allowed before a temporary lock.
# LOGIN_LOCKOUT_SECONDS = how long login is locked after too many wrong tries (900 = 15 minutes).
SESSION_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Direct Mail Config (Stannp)
STANNP_API_KEY=api-eu_your_stannp_api_key
# Set to '0' to post real letters (£ charge), or '1' to generate free digital preview PDFs
STANNP_TEST_MODE=1
