# DealSignal Environment Configuration Template
# Copy this file to a new file named ".env" and fill in your real API keys.
# ⚠️  NEVER commit your real ".env" file to GitHub!

# Homedata Property API Key (https://homedata.co.uk/register — free 100 calls/mo)
HOMEDATA_API_KEY=your_homedata_api_key_here

# Email Newsletter Config (https://resend.com — free tier)
RESEND_API_KEY=your_resend_api_key_here
# Set to 'onboarding@resend.dev' for free testing, or your custom domain for production
FROM_EMAIL=onboarding@resend.dev

# Web App Security
# IMPORTANT: Generate a strong secret for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=change-me-to-a-long-random-string

# Admin dashboard login
# IMPORTANT: Change these before any public deploy!
ADMIN_USERNAME=admin
# Plain password is hashed in memory at startup. Prefer ADMIN_PASSWORD_HASH in production.
ADMIN_PASSWORD=change-me-strong-password
# Optional: store a pre-computed hash instead of plaintext. Generate with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
# ADMIN_PASSWORD_HASH=scrypt:....

# Login session & safety (optional — defaults work fine for demos):
SESSION_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Direct Mail Config (https://stannp.com — pay-per-item)
STANNP_API_KEY=your_stannp_api_key_here
# Set to '0' to post real letters (£ charge), or '1' to generate free digital preview PDFs
STANNP_TEST_MODE=1
